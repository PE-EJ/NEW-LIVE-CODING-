package javaapplication43;

/**
 *
 * @author MABIDA_CPE113
 */
public class NewClass {

    private double x;
    private double y;

    public NewClass(double x, double y) {
        this.x = x;
        this.y = y;
    }

    public void setX(double x) {
        this.x = x;
    }

    public void setY(double y) {
        this.y = y;
    }

    public double getX() {
        return this.x;
    }

    public double getY() {
        return this.y;
    }

    public double calculateDistance(NewClass point) {
        double deltaX = point.getX() - this.x;
        double deltaY = point.getY() - this.y;
        return Math.sqrt(Math.pow(deltaX, 2) + Math.pow(deltaY, 2));
    }

    public double calculateSlope(NewClass point) {
        double deltaX = point.getX() - this.x;

        if (deltaX == 0) {
            throw new ArithmeticException("Undefined (vertical line)");
        }

        double deltaY = point.getY() - this.y;
        return deltaY / deltaX;
    }
}
